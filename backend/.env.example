# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=your_anon_public_key
# Service-role key: SERVER ONLY. Never put it in the frontend or commit it to git.
SUPABASE_SERVICE_KEY=your_service_role_key

# --- Campus restriction ---
# Only these email domains can create a profile (comma separated).
# Set this to YOUR college's student-email domain, e.g. ncuindia.edu
ALLOWED_EMAIL_DOMAINS=ncuindia.edu
REQUIRE_VERIFIED_EMAIL=true

# --- Deployment ---
# Add your deployed frontend URL(s) here (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Profile is auto-hidden after this many different people report it
AUTO_HIDE_REPORTS=3
